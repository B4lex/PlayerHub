msgstr "Не удалось сохранить {}"

msgctxt "ConnectionConnect"
msgid "Connect"
msgstr "Подключиться"

msgctxt "ConnectionCancel"
msgid "Cancel"
msgstr "Отмена"

msgctxt "ConnectionDisconnect"
msgid "Disconnect"
msgstr "Отключиться"

msgctxt "ConnectionConnected"
msgid "Connected"
msgstr "Подключено"

msgctxt "ConnectionConnecting"
msgid "Connecting..."
msgstr "Подключение..."

msgctxt "ConnectionDisconnecting"
msgid "Disconnecting..."
msgstr "Отключение..."

msgctxt "ConnectionDisconnected"
msgid "Disconnected"
msgstr "Отключено"

msgctxt "ConnectionDisconnectToRename"
msgid "Disconnect to change the display name"
msgstr "Отключитесь, чтобы изменить отображаемое имя"

msgctxt "ConnectionCancelToRename"
msgid "Cancel the connection to change the display name"
msgstr "Отмените подключение, чтобы изменить отображаемое имя"

msgctxt "ConnectionNoEndpoint"
msgid "Enter a custom server URL to connect."
msgstr "Введите адрес своего сервера, чтобы подключиться."

#. Shown while the vanilla Helgen intro, before the player can move after the dragon attack, holds the connection
msgctxt "ConnectionGameStage"
msgid "You cannot connect at this game stage."
msgstr "На этом этапе игры подключиться нельзя."

#. {} is the minimum number of characters
#, c++-format
msgctxt "ConnectionShortName"
msgid "The name must be at least {} character long."
msgid_plural "The name must be at least {} characters long."
msgstr[0] "Имя должно содержать не меньше {} символа."
msgstr[1] "Имя должно содержать не меньше {} символов."
msgstr[2] "Имя должно содержать не меньше {} символов."

#. {} is the reason the server gave
#, c++-format
msgctxt "RefusalProtocolMismatch"
msgid "The server runs another protocol version ({})."
msgstr "Сервер использует другую версию протокола ({})."

msgctxt "RefusalDisplayNameTaken"
msgid "The display name is already taken by another player."
msgstr "Это отображаемое имя уже занято другим игроком."

msgctxt "RefusalDisplayNameInvalid"
msgid "The server does not accept the display name."
msgstr "Сервер не принимает это отображаемое имя."

msgctxt "RefusalSessionReplaced"
msgid ""
"Your session connected from another game, which closed this connection. "
"Connect again to take it back."
msgstr ""
"Ваша сессия подключилась из другой игры, и это соединение закрылось. "
"Подключитесь снова, чтобы вернуть её."

msgctxt "RefusalServerFull"
msgid "The server is full."
msgstr "Сервер заполнен."

msgctxt "RefusalTooManyNewSessions"
msgid "Too many new players joined this server from your IP address recently."
msgstr ""
"С вашего IP-адреса к этому серверу недавно подключилось слишком много новых "
"игроков."

msgctxt "RefusalAddressFull"
msgid "Too many players from your IP address are connected to this server."
msgstr "С вашего IP-адреса к этому серверу подключено слишком много игроков."

msgctxt "StatusPing"
msgid "Ping"
msgstr "Пинг"

msgctxt "StatusPlugin"
msgid "Plugin"
msgstr "Плагин"

msgctxt "NoticeConnected"
msgid "Connected to the server"
msgstr "Подключено к серверу"

msgctxt "NoticeRefusedAddressFull"
msgid "Not connected: too many players from your IP address are on this server"
msgstr "Нет подключения: с вашего IP-адреса на этом сервере слишком много игроков"

#. {} is a player's name
#, c++-format
msgctxt "NoticeFriendOnline"
msgid "{} is online"
msgstr "{} в сети"

#. {0} is the key that opens the settings, {1} the name of the Connection tab
#, c++-format
msgctxt "DisplayNameHint"
msgid "Press {0} and enter a display name on the {1} tab to connect"
msgstr ""
"Нажмите {0} и введите отображаемое имя на вкладке {1}, чтобы подключиться"

#. {} is the other player's name
#, c++-format
msgctxt "TradePromptWaiting"
msgid "Waiting for {} to answer your trade offer"
msgstr "Ожидание ответа игрока {} на ваше предложение обмена"

#. {} is the other player's name
#, c++-format
msgctxt "TradePromptInvited"
msgid "{} wants to trade with you"
msgstr "{} предлагает вам обмен"

msgctxt "TradePromptWithdraw"
msgid "Withdraw"
msgstr "Отозвать"

msgctxt "TradePromptAccept"
msgid "Accept"
msgstr "Принять"

msgctxt "TradePromptDecline"
msgid "Decline"
msgstr "Отклонить"

#. {} is the number of seconds left
#, c++-format
msgctxt "TradePromptSeconds"
msgid "{} s"
msgstr "{} с"

msgctxt "ChatGlobal"
msgid "Global"
msgstr "Общий"

msgctxt "ChatNearby"
msgid "Nearby"
msgstr "Рядом"

msgctxt "ChatWhispers"
msgid "Whispers"
msgstr "Личные"

#. {} is a player's name
#, c++-format
msgctxt "ChatTo"
msgid "To {}"
msgstr "Для {}"

#. {} is a player's name
#, c++-format
msgctxt "ChatFrom"
msgid "From {}"
msgstr "От {}"

msgctxt "ChatGlobalTargetHint"
msgid "Send to every player on the server."
msgstr "Отправить всем игрокам на сервере."

msgctxt "ChatNearbyTargetHint"
msgid "Send to players near you."
msgstr "Отправить игрокам рядом с вами."

#. {} is a player's name
#, c++-format
msgctxt "ChatWhisperTargetHint"
msgid "Send a whisper to {}."
msgstr "Отправить личное сообщение игроку {}."

msgctxt "ChatGlobalFilterHint"
msgid "Messages to every player on the server."
msgstr "Сообщения для всех игроков на сервере."

msgctxt "ChatNearbyFilterHint"
msgid "Messages from players near you."
msgstr "Сообщения от игроков рядом с вами."

msgctxt "ChatWhispersFilterHint"
msgid "Private messages between you and one other player."
msgstr "Личные сообщения между вами и другим игроком."

msgctxt "ChatNoPlayerNamed"
msgid "No player with that name is online"
msgstr "Игрока с таким именем нет в сети"

msgctxt "ChatInputHint"
msgid "Press Tab to switch channel"
msgstr "Нажмите Tab, чтобы сменить канал"

msgctxt "PlayersTitle"
msgid "Players"
msgstr "Игроки"

msgctxt "PlayersFriends"
msgid "Friends"
msgstr "Друзья"

msgctxt "PlayersMuted"
msgid "Muted"
msgstr "Заглушённые"

msgctxt "PlayersVanished"
msgid "Vanished"
msgstr "Скрытые"

msgctxt "PlayersRemoveFriend"
msgid "Remove"
msgstr "Удалить"

msgctxt "PlayersUnmute"
msgid "Unmute"
msgstr "Включить звук"

msgctxt "PlayersUnvanish"
msgid "Unvanish"
msgstr "Показать"

msgctxt "PlayersNoFriends"
msgid "You have not added any friends on this server."
msgstr "Вы не добавили друзей на этом сервере."

msgctxt "PlayersNoMuted"
msgid "You have not muted anyone on this server."
msgstr "Вы никого не заглушили на этом сервере."

msgctxt "PlayersNoVanished"
msgid "You have not vanished anyone on this server."
msgstr "Вы никого не скрыли на этом сервере."

msgctxt "PlayersNoMatch"
msgid "No player with that name"
msgstr "Нет игрока с таким именем"

msgctxt "PlayersOnline"
msgid "Online"
msgstr "В сети"

msgctxt "PlayersOffline"
msgid "Offline"
msgstr "Не в сети"

