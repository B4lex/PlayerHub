msgctxt "SectionConnection"
msgid "Connection"
msgstr "Подключение"

msgctxt "SectionDefaultOutfit"
msgid "Default Outfit"
msgstr "Облик по умолчанию"

msgctxt "SectionUI"
msgid "Interface"
msgstr "Интерфейс"

msgctxt "SectionControls"
msgid "Keybinds"
msgstr "Клавиши"

msgctxt "SectionAdvanced"
msgid "Advanced"
msgstr "Дополнительно"

msgctxt "ConnectionDisplayName"
msgid "Display name"
msgstr "Отображаемое имя"

msgctxt "ConnectionDisplayNameComment"
msgid "Shown to other players above your character and in chat."
msgstr "Видно другим игрокам над вашим персонажем и в чате."

msgctxt "ConnectionAutoConnect"
msgid "Connect automatically"
msgstr "Подключаться автоматически"

msgctxt "ConnectionAutoConnectComment"
msgid "Connects to the server automatically after the game is loaded."
msgstr "Подключается к серверу автоматически после загрузки игры."

msgctxt "ConnectionCustomServer"
msgid "Custom server"
msgstr "Свой сервер"

msgctxt "ConnectionCustomServerComment"
msgid "Connects to the server at the URL below instead of the official server."
msgstr "Подключается к серверу по адресу ниже вместо официального сервера."

msgctxt "ConnectionServerEndpoint"
msgid "Server URL"
msgstr "Адрес сервера"

msgctxt "ConnectionServerEndpointComment"
msgid ""
"Custom server URL, starting with http:// or https://. Used only while the\n"
"custom server is on."
msgstr ""
"Адрес своего сервера, начинающийся с http:// или https://. Используется, "
"только пока включён свой сервер."

msgctxt "OutfitComment"
msgid ""
"Player appearance and equipment shown to others in place of your\n"
"modded assets they do not have."
msgstr ""
"Облик и снаряжение, которые другие видят вместо ваших модов, которых у них "
"нет."

