msgstr "Łączenie..."

msgctxt "ConnectionDisconnecting"
msgid "Disconnecting..."
msgstr "Rozłączanie..."

msgctxt "ConnectionDisconnected"
msgid "Disconnected"
msgstr "Rozłączono"

msgctxt "ConnectionDisconnectToRename"
msgid "Disconnect to change the display name"
msgstr "Rozłącz się, aby zmienić nazwę wyświetlaną"

msgctxt "ConnectionCancelToRename"
msgid "Cancel the connection to change the display name"
msgstr "Anuluj łączenie, aby zmienić nazwę wyświetlaną"

msgctxt "ConnectionNoEndpoint"
msgid "Enter a custom server URL to connect."
msgstr "Wpisz adres URL własnego serwera, aby się połączyć."

#. {} is the minimum number of characters
#, c++-format
msgctxt "ConnectionShortName"
msgid "The name must be at least {} character long."
msgid_plural "The name must be at least {} characters long."
msgstr[0] "Nazwa musi mieć co najmniej {} znak."
msgstr[1] "Nazwa musi mieć co najmniej {} znaki."
msgstr[2] "Nazwa musi mieć co najmniej {} znaków."

#. {} is the reason the server gave
#, c++-format
msgctxt "RefusalProtocolMismatch"
msgid "The server runs another protocol version ({})."
msgstr "Serwer używa innej wersji protokołu ({})."

msgctxt "RefusalDisplayNameTaken"
msgid "The display name is already taken by another player."
msgstr "Ta nazwa wyświetlana jest już zajęta przez innego gracza."

msgctxt "RefusalDisplayNameInvalid"
msgid "The server does not accept the display name."
msgstr "Serwer nie akceptuje tej nazwy wyświetlanej."

msgctxt "RefusalSessionReplaced"
msgid ""
"Your session connected from another game, which closed this connection. "
"Connect again to take it back."
msgstr ""
"Twoja sesja połączyła się z innej gry, co zamknęło to połączenie. Połącz się "
"ponownie, aby ją odzyskać."

msgctxt "RefusalServerFull"
msgid "The server is full."
msgstr "Serwer jest pełny."

msgctxt "RefusalTooManyNewSessions"
msgid "Too many new players joined this server from your IP address recently."
msgstr ""
"Z twojego adresu IP dołączyło ostatnio do tego serwera zbyt wielu nowych "
"graczy."

msgctxt "StatusPing"
msgid "Ping"
msgstr "Ping"

msgctxt "StatusPlugin"
msgid "Plugin"
msgstr "Wtyczka"

msgctxt "NoticeConnected"
msgid "Connected to the server"
msgstr "Połączono z serwerem"

#. {} is a player's name
#, c++-format
msgctxt "NoticeFriendOnline"
msgid "{} is online"
msgstr "{} jest dostępny"

#. {0} is the key that opens the settings, {1} the name of the Connection tab
#, c++-format
msgctxt "DisplayNameHint"
msgid "Press {0} and enter a display name on the {1} tab to connect"
msgstr "Naciśnij {0} i wpisz nazwę wyświetlaną na karcie {1}, aby się połączyć"

#. {} is the other player's name
#, c++-format
msgctxt "TradePromptWaiting"
msgid "Waiting for {} to answer your trade offer"
msgstr "Czekasz, aż {} odpowie na twoją ofertę wymiany"

#. {} is the other player's name
#, c++-format
msgctxt "TradePromptInvited"
msgid "{} wants to trade with you"
msgstr "{} chce się z tobą wymienić"

msgctxt "TradePromptWithdraw"
msgid "Withdraw"
msgstr "Wycofaj"

msgctxt "TradePromptAccept"
msgid "Accept"
msgstr "Przyjmij"

msgctxt "TradePromptDecline"
msgid "Decline"
msgstr "Odrzuć"

#. {} is the number of seconds left
#, c++-format
msgctxt "TradePromptSeconds"
msgid "{} s"
msgstr "{} s"

msgctxt "ChatGlobal"
msgid "Global"
msgstr "Globalny"

msgctxt "ChatNearby"
msgid "Nearby"
msgstr "W pobliżu"

msgctxt "ChatWhispers"
msgid "Whispers"
msgstr "Szepty"

#. {} is a player's name
#, c++-format
msgctxt "ChatTo"
msgid "To {}"
msgstr "Do: {}"

#. {} is a player's name
#, c++-format
msgctxt "ChatFrom"
msgid "From {}"
msgstr "Od: {}"

msgctxt "ChatGlobalTargetHint"
msgid "Send to every player on the server."
msgstr "Wyślij do wszystkich graczy na serwerze."

msgctxt "ChatNearbyTargetHint"
msgid "Send to players near you."
msgstr "Wyślij do graczy w pobliżu."

#. {} is a player's name
#, c++-format
msgctxt "ChatWhisperTargetHint"
msgid "Send a whisper to {}."
msgstr "Szepnij do: {}."

msgctxt "ChatGlobalFilterHint"
msgid "Messages to every player on the server."
msgstr "Wiadomości do wszystkich graczy na serwerze."

msgctxt "ChatNearbyFilterHint"
msgid "Messages from players near you."
msgstr "Wiadomości od graczy w pobliżu."

msgctxt "ChatWhispersFilterHint"
msgid "Private messages between you and one other player."
msgstr "Prywatne wiadomości między tobą a innym graczem."

msgctxt "ChatNoPlayerNamed"
msgid "No player with that name is online"
msgstr "Żaden gracz o tej nazwie nie jest dostępny"

msgctxt "ChatInputHint"
msgid "Press Tab to switch channel"
msgstr "Naciśnij Tab, aby zmienić kanał"

msgctxt "PlayersTitle"
msgid "Players"
msgstr "Gracze"

msgctxt "PlayersFriends"
msgid "Friends"
msgstr "Znajomi"

msgctxt "PlayersMuted"
