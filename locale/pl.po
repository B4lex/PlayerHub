msgctxt "PlayersNoFriends"
msgid "You have not added any friends on this server."
msgstr "Nie dodano żadnych znajomych na tym serwerze."

msgctxt "PlayersNoMuted"
msgid "You have not muted anyone on this server."
msgstr "Nikogo nie wyciszono na tym serwerze."

msgctxt "PlayersNoVanished"
msgid "You have not vanished anyone on this server."
msgstr "Nikogo nie ukryto na tym serwerze."

msgctxt "PlayersNoMatch"
