msgctxt "ConnectionDisplayName"
msgid "Display name"
msgstr "顯示名稱"

msgctxt "ConnectionDisplayNameComment"
msgid "Shown to other players above your character and in chat."
msgstr "會在你的角色上方與聊天中顯示給其他玩家。"

msgctxt "ConnectionAutoConnect"
msgid "Connect automatically"
msgstr "自動連線"

msgctxt "ConnectionAutoConnectComment"
msgid "Connects to the server automatically after the game is loaded."
msgstr "遊戲載入後自動連線到伺服器。"

msgctxt "ConnectionCustomServer"
msgid "Custom server"
msgstr "自訂伺服器"

msgctxt "ConnectionCustomServerComment"
msgid "Connects to the server at the URL below instead of the official server."
msgstr "連線到下方網址的伺服器，而非官方伺服器。"

msgctxt "ConnectionServerEndpoint"
msgid "Server URL"
msgstr "伺服器網址"

msgctxt "ConnectionServerEndpointComment"
msgid ""
"Custom server URL, starting with http:// or https://. Used only while the\n"
"custom server is on."
msgstr ""
"自訂伺服器的網址，以 http:// 或 https:// 開頭。只在啟用自訂伺服器時使用。"

msgctxt "OutfitComment"
msgid ""
"Player appearance and equipment shown to others in place of your\n"
"modded assets they do not have."
msgstr "其他玩家沒有你的模組資源時，代為顯示給他們的外觀與裝備。"

