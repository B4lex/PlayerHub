msgid "The name must be at least {} character long."
msgid_plural "The name must be at least {} characters long."
msgstr[0] "Le nom doit comporter au moins {} caractère."
msgstr[1] "Le nom doit comporter au moins {} caractères."

msgctxt "RefusalClientOutdated"
msgid "The server runs a newer version of the mod."
msgstr "Le serveur utilise une version plus récente du mod."

msgctxt "RefusalServerOutdated"
msgid "The server runs an older version of the mod."
msgstr "Le serveur utilise une version plus ancienne du mod."

msgctxt "RefusalDisplayNameTaken"
msgid "The display name is already taken by another player."
msgstr "Ce nom affiché est déjà pris par un autre joueur."

msgctxt "RefusalDisplayNameInvalid"
msgid "The server does not accept the display name."
msgstr "Le serveur n'accepte pas ce nom affiché."

msgctxt "RefusalSessionReplaced"
msgid ""
"Your session connected from another game, which closed this connection. "
"Connect again to take it back."
msgstr ""
"Votre session s'est connectée depuis une autre partie, ce qui a fermé cette "
"connexion. Reconnectez-vous pour la reprendre."

msgctxt "RefusalServerFull"
msgid "The server is full."
msgstr "Le serveur est plein."

msgctxt "RefusalTooManyNewSessions"
msgid "Too many new players joined this server from your IP address recently."
msgstr ""
"Trop de nouveaux joueurs ont rejoint ce serveur depuis votre adresse IP "
"récemment."

msgctxt "RefusalAddressFull"
msgid "Too many players from your IP address are connected to this server."
msgstr "Trop de joueurs de votre adresse IP sont connectés à ce serveur."

msgctxt "RefusalBanned"
msgid "You are banned from this server."
msgstr "Vous êtes banni de ce serveur."

msgctxt "StatusPing"
msgid "Ping"
