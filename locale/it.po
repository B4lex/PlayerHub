msgctxt "PlayerMenuDeclineTrade"
msgid "Decline trade"
msgstr "Rifiuta scambio"

msgctxt "PlayerMenuTrade"
msgid "Trade"
msgstr "Scambia"

msgctxt "PlayerMenuTradeBusy"
msgid "Finish your current trade first."
msgstr "Concludi prima lo scambio in corso."

msgctxt "PlayerMenuTradeHint"
msgid "Offer to exchange items with them."
msgstr "Proponi uno scambio di oggetti."

msgctxt "PlayerMenuTradeChecking"
msgid "Checking whether they are near..."
msgstr "Verifica della distanza..."

msgctxt "PlayerMenuTradeTooFar"
msgid "Stand next to their character to trade."
msgstr "Mettiti accanto al suo personaggio per scambiare."

msgctxt "PlayerMenuAddFriend"
msgid "Add friend"
msgstr "Aggiungi agli amici"

msgctxt "PlayerMenuRemoveFriend"
msgid "Remove friend"
msgstr "Rimuovi dagli amici"

msgctxt "PlayerMenuAddFriendHint"
msgid "Keep them in your friends list and see when they come online."
msgstr "Tienilo nella lista amici e scopri quando si connette."

msgctxt "PlayerMenuRemoveFriendHint"
msgid "Take them off your friends list."
msgstr "Toglilo dalla lista amici."

msgctxt "PlayerMenuMute"
msgid "Mute"
msgstr "Silenzia"

msgctxt "PlayerMenuMuteHint"
msgid "Hide their messages in every channel."
msgstr "Nascondi i suoi messaggi in tutti i canali."

msgctxt "PlayerMenuUnmuteHint"
msgid "Show their messages again."
msgstr "Mostra di nuovo i suoi messaggi."

msgctxt "PlayerMenuVanish"
msgid "Vanish"
msgstr "Fai sparire"

msgctxt "PlayerMenuVanishHint"
msgid "Remove their character from your world."
msgstr "Rimuovi il suo personaggio dal tuo mondo."

msgctxt "PlayerMenuUnvanishHint"
msgid "Show their character in your world again."
msgstr "Mostra di nuovo il suo personaggio nel tuo mondo."

msgctxt "ChatNotConnected"
msgid "Not connected to the server."
msgstr "Non connesso al server."

msgctxt "ChatNoOtherPlayers"
