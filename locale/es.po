msgstr "Pantalla"

msgctxt "UILanguage"
msgid "Language"
msgstr "Idioma"

msgctxt "UILanguageComment"
msgid ""
"Language of the multiplayer interface's text. Until one is picked, it\n"
"follows the game's language."
msgstr ""
"Idioma de los textos de la interfaz multijugador. Hasta que elijas uno, "
"sigue el idioma del juego."

#. This language's name in itself. The language setting lists every language this
#. way, so players find theirs whatever language the text is in.
msgctxt "LanguageName"
msgid "English"
msgstr "Español"

msgctxt "UIScale"
msgid "Scale"
msgstr "Escala"

msgctxt "UIScaleComment"
msgid ""
"Size of the text in the settings window, the chat, and the rest of the\n"
"multiplayer interface. Windows grow and shrink with it."
msgstr ""
"Tamaño del texto en la ventana de ajustes, el chat y el resto de la interfaz "
"multijugador. Las ventanas crecen y se encogen con él."

msgctxt "UIAccentColor"
msgid "Accent color"
msgstr "Color de realce"

msgctxt "UIAccentColorComment"
msgid ""
"Color that marks what can be selected or is selected in the settings window "
"and\n"
"the chat, as hexadecimal RRGGBB."
msgstr ""
"Color que marca lo que se puede seleccionar o está seleccionado en la "
"ventana de ajustes y el chat, en hexadecimal RRGGBB."

msgctxt "UIBorderColor"
msgid "Border color"
msgstr "Color del marco"

msgctxt "UIBorderColorComment"
msgid "Color of the frame around the settings window and the chat."
msgstr "Color del marco alrededor de la ventana de ajustes y el chat."

msgctxt "UIBorderVanilla"
msgid "Vanilla"
msgstr "Vanilla"

msgctxt "UIBorderAccent"
msgid "Accent"
msgstr "Realce"

msgctxt "UIBorderThickness"
msgid "Border thickness"
msgstr "Grosor del marco"

msgctxt "UIBorderThicknessComment"
msgid "Thickness of the frame around the settings window and the chat."
msgstr "Grosor del marco alrededor de la ventana de ajustes y el chat."

msgctxt "UIBackgroundOpacity"
msgid "Background opacity"
msgstr "Opacidad del fondo"

msgctxt "UIBackgroundOpacityComment"
msgid ""
"Opacity of the background behind the multiplayer interface's windows,\n"
"menus, prompts, and notices."
msgstr ""
"Opacidad del fondo tras las ventanas, menús, avisos y notificaciones de la "
"interfaz."

msgctxt "UIGroupPlayers"
msgid "Players"
msgstr "Jugadores"

msgctxt "UINameplates"
msgid "Nameplates"
msgstr "Nombres sobre los jugadores"

msgctxt "UINameplatesComment"
msgid "Shows other players' names above their heads while they are in sight."
msgstr ""
"Muestra los nombres de otros jugadores sobre su cabeza mientras están a la "
"vista."

msgctxt "UINameplateDistance"
msgid "Nameplate distance"
msgstr "Distancia de los nombres"

msgctxt "UINameplateDistanceComment"
msgid ""
"Game units within which names are shown above players' heads, about 70 to a\n"
"meter."
msgstr ""
"Distancia en unidades del juego dentro de la cual se muestran los nombres "
"sobre los jugadores, unas 70 por metro."

msgctxt "UIGroupChat"
msgid "Chat"
msgstr "Chat"

msgctxt "UICloseChatOnSend"
msgid "Close on send"
msgstr "Cerrar al enviar"

msgctxt "UICloseChatOnSendComment"
msgid ""
"Closes the chat when Enter sends a line. Otherwise Enter only sends, and an\n"
"empty line does nothing."
msgstr ""
"Cierra el chat cuando Intro envía una línea. Si no, Intro solo envía y una "
"línea vacía no hace nada."

msgctxt "UIChatHorizontal"
msgid "Horizontal position"
msgstr "Posición horizontal"

msgctxt "UIChatHorizontalComment"
msgid ""
"Distance of the chat's left edge from the screen's left edge, as a share of "
"the\n"
"screen's width. The chat stays on the screen."
msgstr ""
"Distancia del borde izquierdo del chat al borde izquierdo de la pantalla, "
"como fracción del ancho de la pantalla. El chat permanece en la pantalla."

msgctxt "UIChatVertical"
msgid "Vertical position"
msgstr "Posición vertical"

msgctxt "UIChatVerticalComment"
msgid ""
"Distance of the chat's bottom edge from the screen's bottom edge, as a share "
"of\n"
"the screen's height. The chat stays on the screen."
msgstr ""
"Distancia del borde inferior del chat al borde inferior de la pantalla, como "
"fracción de la altura de la pantalla. El chat permanece en la pantalla."

msgctxt "UIGroupItems"
msgid "Items"
msgstr "Objetos"

msgctxt "UIItemPreview"
msgid "Item preview"
msgstr "Vista previa de objetos"

msgctxt "UIItemPreviewComment"
msgid "Shows a 3D model of the hovered item in item lists."
msgstr "Muestra un modelo 3D del objeto señalado en las listas de objetos."

msgctxt "ControlsOpenSettings"
msgid "Open settings"
msgstr "Abrir ajustes"

msgctxt "ControlsOpenSettingsComment"
msgid "Opens and closes the settings window."
msgstr "Abre y cierra la ventana de ajustes."

msgctxt "ControlsOpenChat"
msgid "Open chat"
msgstr "Abrir chat"

msgctxt "ControlsOpenChatComment"
msgid "Opens the chat."
msgstr "Abre el chat."

msgctxt "ControlsManagePlayers"
msgid "Manage players"
msgstr "Gestionar jugadores"

msgctxt "ControlsManagePlayersComment"
msgid ""
"Opens the window that lists your friends and the players you muted or "
"vanished."
msgstr ""
"Abre la ventana que lista a tus amigos y a los jugadores que has silenciado "
"o hecho desaparecer."

msgctxt "ControlsAcceptTrade"
msgid "Accept trade"
msgstr "Aceptar intercambio"

msgctxt "ControlsAcceptTradeComment"
msgid "Accepts another player's trade offer while it waits for an answer."
msgstr ""
"Acepta la oferta de intercambio de otro jugador mientras espera respuesta."

msgctxt "ControlsDeclineTrade"
msgid "Decline trade"
msgstr "Rechazar intercambio"

msgctxt "ControlsDeclineTradeComment"
msgid ""
"Declines another player's trade offer, or withdraws your own, while it "
"waits\n"
"for an answer."
msgstr ""
"Rechaza la oferta de intercambio de otro jugador, o retira la tuya, mientras "
"espera respuesta."

msgctxt "AdvancedGroupPerformance"
msgid "Performance"
msgstr "Rendimiento"

msgctxt "AdvancedViewRadius"
msgid "View radius"
msgstr "Radio de visión"

msgctxt "AdvancedViewRadiusComment"
msgid ""
"Game units within which other players are shown. Applies\n"
"on the next connection."
msgstr ""
"Distancia en unidades del juego dentro de la cual se muestran otros "
"jugadores. Se aplica en la próxima conexión."

msgctxt "AdvancedViewRadiusAuto"
msgid "Auto"
msgstr "Auto"

msgctxt "AdvancedSpawnsPerSecond"
msgid "Spawns per second"
msgstr "Apariciones por segundo"

msgctxt "AdvancedSpawnsPerSecondComment"
msgid ""
"Remote players and mounts spawned per second at most. Many players joining "
"or\n"
"arriving at once then appear over a few seconds instead of in one long "
"frame.\n"
"0 spawns every due player at once."
msgstr ""
"Máximo de jugadores remotos y monturas que aparecen por segundo. Así, muchos "
"jugadores que llegan a la vez aparecen a lo largo de unos segundos en lugar "
"de en un fotograma largo. 0 hace que aparezcan todos de golpe."

msgctxt "AdvancedSpawnsUnlimited"
msgid "Unlimited"
msgstr "Ilimitadas"

msgctxt "AdvancedRemoteLights"
msgid "Lights limit"
msgstr "Límite de luces"

msgctxt "AdvancedRemoteLightsComment"
msgid ""
"Limits player-emitted fake lights (e.g. torch).\n"
"Shadow-casting lights are always converted to fake ones."
msgstr ""
"Limita las luces falsas que emiten los jugadores (p. ej., antorchas).\n"
"Las luces que proyectan sombras siempre se convierten en falsas."

msgctxt "AdvancedGroupDiagnostics"
msgid "Diagnostics"
msgstr "Diagnóstico"

msgctxt "AdvancedStatusPanel"
msgid "Status panel"
msgstr "Panel de estado"

msgctxt "AdvancedStatusPanelComment"
msgid ""
"Shows the ping, network traffic, and the plugin's time per frame in the\n"
"top-right corner."
msgstr ""
"Muestra el ping, el tráfico de red y el tiempo por fotograma del plugin en "
"la esquina superior derecha."

